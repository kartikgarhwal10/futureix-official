# ==============================================================================
# FUTUREIX — CMS & Website Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Administrator Authentication (Built-in Auth Engine)
# ------------------------------------------------------------------------------
# In production, ADMIN_EMAIL, ADMIN_PASSWORD, and ADMIN_SESSION_SECRET are strictly
# required. Default or weak passwords (under 12 characters) are rejected on the server.
ADMIN_EMAIL=editorial@futureix.in
ADMIN_PASSWORD=ChangeThisToAStrongUniquePassword2026!
ADMIN_SESSION_SECRET=generate-a-cryptographically-strong-32-plus-character-secret-key-here

# ------------------------------------------------------------------------------
# 2. Automated Scheduled Publishing CRON Secret
# ------------------------------------------------------------------------------
# Authenticates calls to /api/cms/publish-scheduled.
# Supply via "Authorization: Bearer <CRON_SECRET>" or "x-cron-secret: <CRON_SECRET>"
CRON_SECRET=generate-a-strong-random-cron-secret-for-scheduled-publishing-here

# ------------------------------------------------------------------------------
# 3. Supabase Integration (Production PostgreSQL, Auth & Storage)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Dashboard -> Settings -> API.
# Note: SUPABASE_SERVICE_ROLE_KEY is private and must NEVER be exposed in client code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 4. Production Domain
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://futureix.in
