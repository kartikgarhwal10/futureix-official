# ========================================================
# FUTUREIX — CMS & Website Environment Configuration
# ========================================================

# 1. Admin Authentication Credentials (Built-in Auth)
# Used for primary administrator authentication in /admin/login
ADMIN_EMAIL=admin@futureix.in
ADMIN_PASSWORD=YourStrongPasswordHere!
ADMIN_SESSION_SECRET=generate-a-strong-32-character-random-secret-key-here

# 2. Supabase Integration (Optional but Recommended for Production)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. Production Domain URL
NEXT_PUBLIC_SITE_URL=https://futureix.in
